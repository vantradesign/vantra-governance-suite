# Supabase connection used by @nuxtjs/supabase and by the typed client factory in
# packages/shared/src/supabase.ts.
#
# For local development, start the stack from the repo root with `supabase start`
# and copy the values it prints:
#
#   SUPABASE_URL -> "API URL"
#   SUPABASE_KEY -> the publishable / anon key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=replace-with-the-publishable-key-from-supabase-status
