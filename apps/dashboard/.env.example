# Supabase connection used by @nuxtjs/supabase and by the typed client factories
# in packages/shared/src/supabase.ts.
#
# LOCAL: start the stack from the repo root with `supabase start` and copy the
# values it prints (`supabase status`):
#
#   SUPABASE_URL              -> "API URL"
#   SUPABASE_KEY              -> the publishable key
#   SUPABASE_SERVICE_ROLE_KEY -> the secret key
#
# HOSTED: take the URL and keys from Project Settings -> API. Make sure the
# migrations have been applied to that project first (`supabase db push`),
# otherwise PostgREST answers 404 "Could not find the table".

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=replace-with-the-publishable-key-from-supabase-status

# Server-side only. Bypasses RLS and has full table access, so it must never be
# exposed to the browser — it is read exclusively by Nitro routes under
# server/api/ via `createVantraServiceClient()`.
#
# Required: `anon` is intentionally granted no table privileges, so every read
# goes through the server. Without this the dashboard shows a 502.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-secret-key-from-supabase-status

# Local development only. Every route under server/api/ requires an authenticated
# Supabase session (server/utils/requireDashboardUser.ts), and no login page exists
# yet, so the dashboard answers 401 until one lands. Set this to work against a
# seeded local stack in the meantime.
#
# It is read ONLY when Nuxt runs in dev mode, so it cannot weaken a deployed
# build even if it ends up set in a production environment. Do not remove that
# condition without recording the decision in DECISIONS.md.
# DASHBOARD_ALLOW_ANONYMOUS=true
