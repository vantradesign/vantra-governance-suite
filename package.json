{
  "name": "vantra-governance-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo hosting the five Vantra CI governance tools plus a shared dashboard UI, all sharing a single component graph parsed by @vantra-design/core.",
  "license": "AGPL-3.0-only",
  "author": "Vantra Design <vantra@kauper.co>",
  "homepage": "https://github.com/vantradesign/vantra-governance-suite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantradesign/vantra-governance-suite.git"
  },
  "bugs": {
    "url": "https://github.com/vantradesign/vantra-governance-suite/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "verify": "turbo run lint typecheck build test",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/database.ts",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
